# Hosted value is managed by Sites. Local sign-in identity only:
ADMIN_EMAILS=seedy@sites.test

# Récolte automatique des replays (POST /api/replay/ingest) — secret partagé
# avec le crawler (scripts/replay-nightly.sh, header X-Ingest-Secret).
# Poser la valeur dans .dev.vars (canal ADMIN_EMAILS, copié vers
# dist/server/.dev.vars par le build) ; absent = ingestion désactivée (503).
# Générer : openssl rand -hex 32
INGEST_SECRET=<openssl rand -hex 32>
